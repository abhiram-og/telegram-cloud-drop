APP_BASE_URL=https://files.example.com
POSTGRES_DB=filebot
POSTGRES_USER=filebot
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://filebot:replace-with-a-long-random-password@postgres:5432/filebot
TELEGRAM_BOT_TOKEN=replace-me
# The local Bot API must be used for multi-gigabyte downloads. Do not use api.telegram.org.
TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
TELEGRAM_LOCAL_FILES=true
TELEGRAM_API_ID=replace-with-your-numeric-api-id
TELEGRAM_API_HASH=replace-with-your-api-hash

S3_ENDPOINT_URL=http://minio:9000
S3_REGION=auto
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=telegram-files
DOWNLOAD_LINK_TTL_HOURS=168
MAX_BATCH_FILES=100
WORKER_POLL_SECONDS=3
